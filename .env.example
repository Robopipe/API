HOST=0.0.0.0
PORT=8080

CORS_ORIGINS=*

CONTROLLER_CONFIG=/path/to/robopipe/config/dir

# Discovery
DISCOVERY_MDNS_ENABLED=true
DISCOVERY_UDP_ENABLED=true
DISCOVERY_UDP_PORT=5685

# Storage cleanup — periodically deletes oldest event pictures and reports
# when free disk space on the data partition drops below MIN_FREE_PCT,
# stopping once it reaches TARGET_FREE_PCT.
ROBOPIPE_CLEANUP_INTERVAL_SECONDS=3600
ROBOPIPE_CLEANUP_MIN_FREE_PCT=10
ROBOPIPE_CLEANUP_TARGET_FREE_PCT=20
ROBOPIPE_CLEANUP_BATCH_SIZE=100

# Rolling video recording — continuously keeps the most recent footage of
# each camera's main sensor on disk (~15 s WebM segments), retrievable as a
# single file via GET /cameras/{mxid}/recording.
ROBOPIPE_RECORDING_ENABLED=false
ROBOPIPE_RECORDING_MAX_DURATION_SECONDS=600
